{
  "html": "<div style=\"background-color:#1C2B35;padding:56px 32px;text-align:center;margin:48px 0;border-radius:12px;\"><h2 style=\"color:#FFFFFF;font-family:'Inter',sans-serif;font-size:2rem;font-weight:600;margin:0 0 16px;line-height:1.2;\">{{title}}</h2><p style=\"color:rgb(245 240 232 / 85%);font-family:'Inter',sans-serif;font-size:1.1rem;margin:0 auto 28px;max-width:560px;line-height:1.6;\">{{description}}</p><a href=\"{{href}}\" style=\"display:inline-block;background-color:#B5651D;color:#FFFFFF;font-family:'Inter',sans-serif;font-size:17px;font-weight:500;padding:0.7em 2.2em;border-radius:100px;text-decoration:none;text-transform:uppercase;letter-spacing:0.1em;border:1.5px solid #B5651D;box-shadow:0 4px 20px rgb(28 43 53 / 8%);\">{{buttonText}}</a></div>",
  "slots": ["title", "description", "buttonText"],
  "fallback": {
    "title": "Find Your Perfect Setup",
    "description": "Explore espresso machines, grinders, and accessories chosen to fit the way you brew.",
    "buttonText": "Explore Machines"
  }
}
