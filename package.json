{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:fix": "bun run lint:js --fix && bun run lint:css --fix",
    "test:browser": "node --test tools/test-generation-loading.mjs",
    "loadtest": "node tools/loadtest/loadtest.js",
    "loadtest:quick": "node tools/loadtest/loadtest.js --total 10 --parallel 2",
    "loadtest:generate-prompts": "node tools/loadtest/generate-prompts.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "playwright": "^1.58.2",
    "stylelint": "17.3.0",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {}
}
